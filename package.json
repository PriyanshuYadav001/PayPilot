    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.65.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
